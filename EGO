	SystemEvent:FireClient(player,"FLY",flying[player])
end

--========================================================
-- COMMANDS
--========================================================

local function command(player, message)

	if message:sub(1,1) ~= PREFIX then
		return
	end

	local args = string.split(message," ")
	local cmd = args[1]:lower()

	table.remove(args,1)

	--====================================================
	-- FLY
	-- ARCHITECT / STAFF / H4CKER
	--====================================================

	if cmd == "/fly" then

		if hasAllCommands(player) or isHacker(player) then
			toggleFly(player)
		else
			SystemEvent:FireClient(player,"ERROR","You don't have permission.")
		end

		return
	end

	--====================================================
	-- ALL OTHER COMMANDS
	-- ARCHITECT + STAFF ONLY
	--====================================================

	if not hasAllCommands(player) then
		SystemEvent:FireClient(player,"ERROR","You don't have permission.")
		return
	end

	--====================================================
	-- BAN
	--====================================================

	if cmd == "/ban" then

		local target = findPlayer(args[1])

		if target then
			pcall(function()
				BanStore:SetAsync(tostring(target.UserId),true)
			end)

			target:Kick("You have been banned from EGO.")
		end

	--====================================================
	-- UNBAN
	--====================================================

	elseif cmd == "/unban" then

		local userId = tonumber(args[1])

		if userId then
			pcall(function()
				BanStore:RemoveAsync(tostring(userId))
			end)
		end

	--====================================================
	-- MUTE
	--====================================================

	elseif cmd == "/mute" then

		local target = findPlayer(args[1])

		if target then
			local mute = target:FindFirstChild("EGO_Muted")

			if not mute then
				mute = Instance.new("BoolValue")
				mute.Name = "EGO_Muted"
				mute.Parent = target
			end

			mute.Value = true
			SystemEvent:FireAllClients(
				"NOTICE",
				target.DisplayName.." was muted."
			)
		end

	--====================================================
	-- UNMUTE
	--====================================================

	elseif cmd == "/unmute" then

		local target = findPlayer(args[1])

		if target then
			local mute = target:FindFirstChild("EGO_Muted")

			if mute then
				mute.Value = false
			end
		end

	--====================================================
	-- ANNOUNCEMENT
	--====================================================

	elseif cmd == "/announcement" then

		local text = table.concat(args," ")

		if text ~= "" then
			SystemEvent:FireAllClients("ANNOUNCEMENT",text)

			pcall(function()
				MessagingService:PublishAsync(
					GLOBAL_TOPIC,
					{
						Type = "ANNOUNCEMENT",
						Message = text,
						From = player.DisplayName
					}
				)
			end)
		end

	--====================================================
	-- NOCLIP
	--====================================================

	elseif cmd == "/noclip" then

		SystemEvent:FireClient(player,"NOCLIP")

	--====================================================
	-- GIVE TITLE
	--====================================================

	elseif cmd == "/givetitles" then

		local target = findPlayer(args[1])
		local title = table.concat(args," ",2)

		if target and TITLES[title] then
			applyTitle(target,title)

			if target.Character then
				createTitleTag(target,target.Character)
			end

			SystemEvent:FireAllClients(
				"NOTICE",
				target.DisplayName.." received "..title
			)
		end

	--====================================================
	-- GIVE ADMIN
	-- ONLY ARCHITECT
	--====================================================

	elseif cmd == "/giveadmin" then

		if not isArchitect(player) then
			SystemEvent:FireClient(player,"ERROR","Only ARCHITECT can use /giveadmin.")
			return
		end

		local target = findPlayer(args[1])
		local rank = args[2] or "STAFF"

		if target and (rank == "STAFF" or rank == "H4CKER") then

			admins[target.UserId] = rank

			pcall(function()
				AdminStore:SetAsync(
					tostring(target.UserId),
					rank
				)
			end)

			SystemEvent:FireAllClients(
				"NOTICE",
				target.DisplayName.." is now "..rank
			)
		end
	end
end

--========================================================
-- SERVER CHAT
--========================================================

local function sendServerMessage(player,message)

	local muted = player:FindFirstChild("EGO_Muted")

	if muted and muted.Value then
		return
	end

	local title = "ELITE"
	local titleValue = player:FindFirstChild("EGO_Title")

	if titleValue then
		title = titleValue.Value
	end

	ChatEvent:FireAllClients(
		"SERVER",
		player.DisplayName,
		message,
		title
	)
end

--========================================================
-- GLOBAL CHAT
--========================================================

local function publishGlobal(player,message)

	local muted = player:FindFirstChild("EGO_Muted")

	if muted and muted.Value then
		return
	end

	local title = "ELITE"
	local titleValue = player:FindFirstChild("EGO_Title")

	if titleValue then
		title = titleValue.Value
	end

	pcall(function()
		MessagingService:PublishAsync(
			GLOBAL_TOPIC,
			{
				Type = "CHAT",
				User = player.DisplayName,
				Message = message,
				Title = title
			}
		)
	end)
end

--========================================================
-- MESSAGING SERVICE
--========================================================

pcall(function()

	MessagingService:SubscribeAsync(
		GLOBAL_TOPIC,
		function(data)

			local info = data.Data

			if info.Type == "CHAT" then

				ChatEvent:FireAllClients(
					"GLOBAL",
					info.User,
					info.Message,
					info.Title
				)

			elseif info.Type == "ANNOUNCEMENT" then

				SystemEvent:FireAllClients(
					"ANNOUNCEMENT",
					info.Message
				)
			end
		end
	)

end)

--========================================================
-- PLAYER
--========================================================

Players.PlayerAdded:Connect(function(player)

	loadAdmin(player)
	checkBan(player)
	loadTitle(player)

	player.CharacterAdded:Connect(function(character)
		task.wait(1)
		createTitleTag(player,character)
	end)

	player.Chatted:Connect(function(message)

		if message:sub(1,1) == "/" then
			command(player,message)
		else
			sendServerMessage(player,message)
		end
	end)

end)

Players.PlayerRemoving:Connect(function(player)
	flying[player] = nil
end) 
