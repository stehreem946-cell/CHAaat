local function getTitleColor(title)
	if title == "H4CKER🧑‍💻" then
		return Color3.fromRGB(0,255,80)
	elseif title == "--khalnayak--" then
		return Color3.fromRGB(170,0,255)
	elseif title == "--danav--" then
		return Color3.fromRGB(255,0,0)
	elseif title == "DISB4NDER💀" then
		return Color3.fromRGB(0,150,255)
	elseif TITLES[title] == "RAINBOW" then
		return Color3.fromRGB(255,255,255)
	end

	return Color3.fromRGB(0,0,0)
end

--========================================================
-- CREATOR / PERMISSIONS
--========================================================

local CREATOR_ID = game.CreatorId

local admins = {}

local function isArchitect(player)
	return player.UserId == CREATOR_ID or admins[player.UserId] == "ARCHITECT"
end

local function isStaff(player)
	return isArchitect(player) or admins[player.UserId] == "STAFF"
end

local function isHacker(player)
	return admins[player.UserId] == "H4CKER"
end

local function hasAllCommands(player)
	return isArchitect(player) or isStaff(player)
end

--========================================================
-- LOAD ADMIN
--========================================================

local function loadAdmin(player)
	local success, result = pcall(function()
		return AdminStore:GetAsync(tostring(player.UserId))
	end)

	if success and result then
		admins[player.UserId] = result
	end
end

--========================================================
-- BAN CHECK
--========================================================

local function checkBan(player)
	local success, data = pcall(function()
		return BanStore:GetAsync(tostring(player.UserId))
	end)

	if success and data then
		player:Kick("You are banned from EGO.")
	end
end

--========================================================
-- TITLE
--========================================================

local function applyTitle(player, title)
	if not TITLES[title] then
		return false
	end

	local old = player:FindFirstChild("EGO_Title")

	if old then
		old.Value = title
	else
		local value = Instance.new("StringValue")
		value.Name = "EGO_Title"
		value.Value = title
		value.Parent = player
	end

	local success = pcall(function()
		TitleStore:SetAsync(tostring(player.UserId), title)
	end)

	return success
end

local function loadTitle(player)
	local success, title = pcall(function()
		return TitleStore:GetAsync(tostring(player.UserId))
	end)

	if success and title and TITLES[title] then
		applyTitle(player, title)
	end
end

--========================================================
-- CHARACTER TITLE TAG
--========================================================

local function createTitleTag(player, character)
	local head = character:WaitForChild("Head", 10)
	if not head then return end

	local old = head:FindFirstChild("EGO_TitleTag")
	if old then
		old:Destroy()
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "EGO_TitleTag"
	billboard.Size = UDim2.new(0,220,0,45)
	billboard.StudsOffset = Vector3.new(0,3,0)
	billboard.AlwaysOnTop = true
	billboard.Parent = head

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1,1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.2
	label.Parent = billboard

	local titleValue = player:FindFirstChild("EGO_Title")

	if titleValue then
		label.Text = titleValue.Value
		label.TextColor3 = getTitleColor(titleValue.Value)

		if TITLES[titleValue.Value] == "RAINBOW" then
			task.spawn(function()
				local hue = 0

				while label.Parent and player.Parent do
					hue = (hue + 0.01) % 1
					label.TextColor3 = Color3.fromHSV(hue,1,1)
					task.wait(0.03)
				end
			end)
		end
	end
end

--========================================================
-- FIND PLAYER
--========================================================

local function findPlayer(text)
	if not text then return nil end

	text = text:lower()

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower() == text or player.DisplayName:lower() == text then
			return player
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player.Name:lower():sub(1,#text) == text then
			return player
		end
	end
end

